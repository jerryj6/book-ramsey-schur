def b49Red (u v : Fin 26) : Bool :=
  if u.val < v.val then
    decide ((u.val, v.val) ∈ b49Edges)
  else if v.val < u.val then
    decide ((v.val, u.val) ∈ b49Edges)
  else
    false

set_option maxRecDepth 1000000 in
set_option maxHeartbeats 0 in
theorem b49_lower : LowerBound 26 4 9 := by
  refine ⟨b49Red, ?_⟩
  dsimp [Symm, BookFree, redCodeg, blueCodeg]
  native_decide

end BookRamsey
